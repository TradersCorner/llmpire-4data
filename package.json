{
  "name": "4data",
  "version": "1.0.0",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/v1/index.js",
    "bridge": "node src/bridge/index.js",
    "watch": "node src/v1/cli/watch-stream.js",
    "digest": "node src/digest/index.js",
    "sidekick:foodtrucks": "tsx src/sidekick/foodtrucks.ts",
    "bridge:sidekick": "tsx src/bridge/sidekickToV1.ts --spawn \"npm run sidekick:foodtrucks\"",
    "bridge:sidekick:dry": "tsx src/bridge/sidekickToV1.ts --spawn \"npm run sidekick:foodtrucks\" --dryRun",
    "vac:evaluate": "tsx src/vac/cli.ts",
    "vac:decision-cards": "node src/decision/cli-decision-cards.mjs",
    "vac:public-decision-cards": "node cli-public-decision-cards.mjs",
    "admin:queues": "node src/admin/cli-admin-queues.mjs",
    "check": "node scripts/lisa-check.mjs all",
    "typecheck": "node scripts/lisa-check.mjs typecheck",
    "lint": "node scripts/lisa-check.mjs lint",
    "test": "node scripts/lisa-check.mjs test",
    "build": "node scripts/lisa-check.mjs build",
    "audit:lisa": "node scripts/lisa-audit.mjs",
    "preflight": "npm run check && npm run test && npm run audit:lisa",
    "gov:env:bash": "node scripts/gov/print-gov-env.mjs --bash",
    "gov:env:ps": "node scripts/gov/print-gov-env.mjs --ps",
    "gov:env:both": "node scripts/gov/print-gov-env.mjs --both",
    "gov:env:write": "node scripts/gov/print-gov-env.mjs --both --write-env",
    "gov:smoke:e2e": "node scripts/gov/smoke-gov-e2e.mjs",
    "gov:export": "node scripts/gov/export-ndjson.mjs",
    "gov:prove": "npm run gov:export && npm run gov:env:write && npm run gov:smoke:e2e"
  },
  "dependencies": {
    "better-sqlite3": "^12.5.0",
    "cheerio": "^1.0.0",
    "luxon": "^3.5.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "eslint": "^9.39.2",
    "eslint-plugin-boundaries": "^5.3.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
