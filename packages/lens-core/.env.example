# Lens Core
LENS_PORT=3001
V1_STREAM_URL=http://localhost:3000/stream
LENS_TOKEN=changeme-local-token
LENS_ALLOWED_ORIGINS=http://localhost:3000
LENS_EXTENSION_ID=
LENS_ALLOW_QUERY_TOKEN=false # header-only by default; opt in explicitly for local compatibility

# Default upstream routing
LENS_DEFAULT_UPSTREAM=openai   # openai | anthropic
LENS_MODE=assist               # assist | strict

# OpenAI (Responses API)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5

# Anthropic (Messages API)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
ANTHROPIC_VERSION=2023-06-01
